<!DOCTYPE html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sistemas RH</title><style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');
:root{font-family:Inter,Arial,sans-serif;color:#26313d;background:#f4f6f9}*{box-sizing:border-box}body{margin:0}header{background:linear-gradient(115deg,#e76a19,#f59b40);color:white;text-align:center;padding:57px 20px 65px}header h1{font-size:clamp(32px,5vw,52px);margin:0 0 10px}header p{opacity:.95;margin:0;font-size:16px}.wrap{max-width:1160px;margin:-30px auto 60px;padding:0 22px}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.card{background:white;border-radius:20px;box-shadow:0 8px 28px #27344912;padding:25px 17px 22px;text-align:center;display:flex;flex-direction:column;align-items:center;min-height:285px;border:1px solid #e8ebef;transition:transform .2s,box-shadow .2s}.card.active:hover{transform:translateY(-6px);box-shadow:0 15px 34px #27344920}.robot{height:138px;width:138px;margin:0 auto 12px}.card h2{font-size:16px;line-height:1.4;margin:0 0 15px;min-height:45px}.btn{margin-top:auto;background:#eb741f;color:white;text-decoration:none;padding:11px 20px;border-radius:11px;font-size:13px;font-weight:700;width:100%}.pending{opacity:.65}.pending .btn{background:#dce1e7;color:#596574;cursor:default}.tag{font-size:11px;letter-spacing:.09em;color:#a4abb5;font-weight:700;margin-bottom:10px}footer{text-align:center;color:#87919d;padding:10px 20px 30px;font-size:12px}@media(max-width:900px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:520px){.grid{grid-template-columns:1fr}.wrap{max-width:370px}}
</style></head><body><header><h1>Sistemas RH</h1><p>Central de acesso aos sistemas de gestão</p></header><main class="wrap"><div class="grid" id="grid"></div></main><footer>Central de Sistemas RH • Lumanoids</footer><script>
const systems=[
{name:"Gestão de Tarefas",url:"https://applumanoids.github.io/Gestao-de-tarefas/"},
{name:"Gestão CIPA",url:"https://applumanoids.github.io/Gestao-CIPA/"},
{name:"Gestão de Saúde Ocupacional",url:"https://applumanoids.github.io/Gestao-de-Saude-Ocupacional/"},
...Array.from({length:5},()=>({name:"Em construção",url:null}))
];
const accessories=[
`<g transform="translate(103 91) rotate(12)"><rect x="0" y="0" width="31" height="39" rx="3" fill="#fff" stroke="#6e8195" stroke-width="2"/><path d="M7 10h17M7 17h17M7 24h12" stroke="#e7a16c" stroke-width="2"/><path d="M28 -8l5 0 0 42 -2 7 -3 -7z" fill="#e7a323" stroke="#8a6320" stroke-width="1.5"/></g>`,
`<path d="M44 48q0-29 36-29t36 29z" fill="#ffb83e" stroke="#c77e1b" stroke-width="3"/><rect x="39" y="45" width="82" height="9" rx="4" fill="#e89522"/><path d="M80 20v25" stroke="#e18c22" stroke-width="5"/><g transform="translate(109 112)"><rect width="30" height="33" rx="3" fill="#fff" stroke="#7d8b99" stroke-width="2"/><path d="M7 10l4 4 7-8M7 23l4 4 7-8" stroke="#e87520" stroke-width="2" fill="none"/></g>`,
`<path d="M40 49V35q0-11 11-11h58q11 0 11 11v14" fill="#fff" stroke="#cdd7df" stroke-width="3"/><path d="M80 23v23M69 34h22" stroke="#e87520" stroke-width="6"/><path d="M52 114v16q0 15 20 15t20-15v-10" fill="none" stroke="#78899a" stroke-width="5"/><circle cx="93" cy="120" r="7" fill="#e87520" stroke="#fff" stroke-width="2"/>`
];
const robot=(i,disabled)=>`<svg class="robot" viewBox="0 0 160 160" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Robô ${disabled?'em construção':systems[i].name}"><defs><linearGradient id="g${i}" x1="0" y1="0" x2="1" y2="1"><stop stop-color="${disabled?'#aeb8c4':'#ffab55'}"/><stop offset="1" stop-color="${disabled?'#d9dfe6':'#e7681c'}"/></linearGradient></defs><circle cx="80" cy="80" r="71" fill="${disabled?'#f0f2f5':'#fff1e5'}"/><path d="M80 27V41" stroke="#6b7788" stroke-width="6" stroke-linecap="round"/><circle cx="80" cy="24" r="7" fill="#f18730"/><rect x="36" y="43" width="88" height="76" rx="24" fill="url(#g${i})" stroke="#d1d7df" stroke-width="3"/><rect x="45" y="59" width="70" height="42" rx="15" fill="#253447"/><circle cx="64" cy="80" r="8" fill="#fff"/><circle cx="96" cy="80" r="8" fill="#fff"/><circle cx="66" cy="80" r="3" fill="#f18a30"/><circle cx="98" cy="80" r="3" fill="#f18a30"/><path d="M72 95Q80 101 88 95" fill="none" stroke="#ffaf65" stroke-width="3" stroke-linecap="round"/><rect x="26" y="73" width="12" height="25" rx="6" fill="#9ba9b9"/><rect x="122" y="73" width="12" height="25" rx="6" fill="#9ba9b9"/><rect x="57" y="119" width="46" height="12" rx="6" fill="#8b9aaa"/>${accessories[i]||'<g transform="translate(105 113)"><rect width="42" height="22" rx="4" fill="#e2e6eb" stroke="#aeb8c4"/><text x="21" y="15" font-size="9" text-anchor="middle" fill="#667384">EM BREVE</text></g>'}</svg>`;
document.getElementById('grid').innerHTML=systems.map((s,i)=>`<article class="card ${s.url?'active':'pending'}">${robot(i,!s.url)}<div class="tag">${s.url?'SISTEMA '+String(i+1).padStart(2,'0'):'EM BREVE'}</div><h2>${s.name}</h2>${s.url?`<a class="btn" href="${s.url}" target="_blank" rel="noopener noreferrer">Acessar sistema ↗</a>`:'<span class="btn">Em construção</span>'}</article>`).join('');
</script></body></html>
